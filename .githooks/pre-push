#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
    echo 'Push blocked: install gitleaks.' >&2
    exit 1
fi
# This small dotfiles repository can afford a full scan, including old commits.
exec gitleaks git --log-opts=--all --redact=100 --no-banner .
