# Pi: track configuration only. Keep credentials, caches, installs, and run data out.
dot_pi/private_agent/*
!dot_pi/private_agent/AGENTS.md
!dot_pi/private_agent/settings.json
!dot_pi/private_agent/mcp.json
!dot_pi/private_agent/zentui.json
!dot_pi/private_agent/agents/
dot_pi/private_agent/agents/*
!dot_pi/private_agent/agents/delegate.md
!dot_pi/private_agent/skills/
dot_pi/private_agent/skills/*
!dot_pi/private_agent/skills/refactor/
!dot_pi/private_agent/skills/refactor/SKILL.md

# Decman Python artifacts, including chezmoi source-state dot names.
dot_config/decman/**/.venv/
dot_config/decman/**/__pycache__/
dot_config/decman/**/.ruff_cache/
dot_config/decman/**/.pytest_cache/
dot_config/decman/**/.mypy_cache/
dot_config/decman/**/dot_git
dot_config/decman/**/dot_venv/
dot_config/decman/**/dot_ruff_cache/
dot_config/decman/**/dot_pytest_cache/
dot_config/decman/**/dot_mypy_cache/
dot_config/decman/**/*.py[cod]
