{
	"name": "visual-report",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"export": "vite build --config vite.export.config.ts && bun scripts/finish-export.ts",
		"serve": "vite preview --config vite.export.config.ts --port 4173 --strictPort",
		"prepare": "svelte-kit sync && lefthook install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@shadcn/lint": "^0.2.3",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@typescript-eslint/parser": "^8.72.0",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lefthook": "^2.2.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.10.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vite-plugin-singlefile": "^2.3.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
