[credential]
	helper = store
[user]
	email = lawjaylee1@icloud.com
	name = Lawjay Lee
[init]
	defaultBranch = main
[push]
    autoSetupRemote = true
    default = current
[color]
	ui = auto
[core]
	pager = bat
[alias]
    a = add
    amend = commit --amend
    b = branch
    c = clone
    co = checkout
    d = diff --cached
    dc = diff --cached
    df = diff
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    last = log -1 HEAD
    p = pull
    ph = push
    r = restore
    show = show --ext-diff
    s = status
    u = reset HEAD --
    unstage = reset HEAD --
[diff]
    external = difft
	tool = difftastic
	colorMoved = dimmed-zebra
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[color "status"]
	branch = 12 normal
	added = 10 normal
	updated = 10 normal
	localbranch = 12 normal
	changed = 11 normal
	header = normal
	remotebranch = 6 normal
	nobranch = 1 normal
	unmerged = 9 normal
	untracked = 8 normal
[color "branch"]
	plain = normal
	remote = 6 normal
	current = 15 4
	local = 12 normal
	upstream = 6 normal
[color "remote"]
	hint = 8 normal
	success = 10 normal
	error = 9 normal
	warning = 11 normal
[color "interactive"]
	header = 8 normal bold
	prompt = 15 4
	help = 8 normal
	error = 9 normal
[color "diff"]
	commit = 3 normal
	newMoved = 11 0
	oldMovedAlternativeDimmed = 6 0 dim
	frag = 8 normal
	oldMovedAlternative = 6 0
	contextBold = normal bold
	newBold = 10 0 bold
	context = normal
	contextDimmed = normal dim
	oldMoved = 3 0
	oldBold = 1 0 bold
	newMovedDimmed = 11 normal
	func = 8 normal
	meta = 8 normal
	newDimmed = 10 normal
	newMovedAlternative = 14 0
	new = 10 0
	newMovedAlternativeDimmed = 11 normal
	whitespace = normal 3
	oldMovedDimmed = 3 0 dim
	oldDimmed = 1 0 dim
	old = 1 0
[color "decorate"]
	branch = 12 normal
	tag = 5 normal
	remotebranch = 6 normal
	stash = 3 normal
	grafted = 1 normal
	HEAD = 7 4
