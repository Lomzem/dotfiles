export PAGER="bat"
export BAT_PAGER="less -R"
export MANPAGER='nvim +Man!'
export EDITOR='nvim'
export VISUAL='nvim'
export HISTSIZE=10000
export SAVEHIST=10000

autoload -Uz +X "$HOME/.cache/zsh/zasync/zasync" # soourced before antidote to fix zsh-autocomplete

source '/usr/share/zsh-antidote/antidote.zsh'
antidote load

# Generated by ~/.local/share/zcolors/zcolors.
source "$ZDOTDIR/zcolors-theme.zsh"

# Reduce the delay before a lone Esc leaves insert mode.
KEYTIMEOUT=1
bindkey -v

alias cz=chezmoi
alias ls=eza

alias gs='git status'
alias gp='git pull'
alias gph='git push'

eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"

# Atuin history search on Ctrl-R, without its arrow or AI shortcuts.
eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
bindkey -M vicmd '^R' atuin-search-vicmd

# Restore native arrow navigation after plugins have set their bindings.
for keymap in viins vicmd emacs; do
  bindkey -M "$keymap" '^[[A' up-line-or-history
  bindkey -M "$keymap" '^[[B' down-line-or-history
  bindkey -M "$keymap" '^[OA' up-line-or-history
  bindkey -M "$keymap" '^[OB' down-line-or-history
done
unset keymap
