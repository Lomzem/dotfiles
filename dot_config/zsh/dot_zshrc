export PATH="$PATH:$HOME/.local/bin"

# esp32 stuff
export LIBCLANG_PATH="/home/lomzem/.rustup/toolchains/esp/xtensa-esp32-elf-clang/esp-20.1.1_20250829/esp-clang/lib"
export PATH="/home/lomzem/.rustup/toolchains/esp/xtensa-esp-elf/esp-15.2.0_20250920/xtensa-esp-elf/bin:$PATH"

export PAGER="bat"
export BAT_PAGER="less -R"
export MANPAGER='nvim +Man!'
export EDITOR='nvim'
export VISUAL='nvim'
# A leading space keeps a command out of native history and Atuin.
setopt HIST_IGNORE_SPACE

export HISTSIZE=10000
export SAVEHIST=10000

# Preload zasync to work around zsh-autocomplete's dependency-loading bug.
autoload -Uz +X "$HOME/.cache/zsh/zasync/zasync"

source '/usr/share/zsh-antidote/antidote.zsh'
antidote load

# Generated by ~/.local/share/zcolors/zcolors.
source "$ZDOTDIR/zcolors-theme.zsh"

# Reduce the delay before a lone Esc leaves insert mode.
KEYTIMEOUT=1
bindkey -v

alias cc='claude --dangerously-skip-permissions'
alias claude='claude --dangerously-skip-permissions'

alias cl=clear
alias cls=clear
alias cz=chezmoi
alias upd='sudo decman --source "$HOME/.config/decman/source.py"'
alias ls=eza
alias rmf='rm -rf'
alias sd='shutdown now'
alias rs='reboot now'
alias so="source $ZDOTDIR/.zshrc"

alias -g xc='| sed -z "s/^[[:space:]]*//; s/[[:space:]]*$//" | wl-copy'

alias codex='codex --yolo'

alias ga='git add .'
alias gA='git add -A'
alias gs='git status'
alias gp='git pull'
alias gph='git push'

eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"

# Atuin history search on Ctrl-R, without its arrow or AI shortcuts.
eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
bindkey -M vicmd '^R' atuin-search-vicmd

# Native history, including this keyboard's Esc+k / Esc+j arrow sequences.
zstyle ':autocomplete:.(up|down)-line-or-history:*' ignore yes
for keymap in viins vicmd emacs; do
  bindkey -M "$keymap" '^[[A' .up-line-or-history '^[OA' .up-line-or-history '^[k' .up-line-or-history
  bindkey -M "$keymap" '^[[B' .down-line-or-history '^[OB' .down-line-or-history '^[j' .down-line-or-history
done
unset keymap
bindkey -M vicmd 'k' .up-line-or-history 'j' .down-line-or-history

function enter_nvim() { nvim }
zle -N enter_nvim
bindkey -M viins ^n enter_nvim

function gcm() { git commit -m "$*" }
zle -N gcm

# Jump to a project or managed config directory through zoxide's cd function.
function television-cd() {
  local dir
  if dir=$(command tv project-dirs --no-remote --no-sort) && [[ -n "$dir" && -d "$dir" ]]; then
    cd -- "$dir"
    zle reset-prompt
  fi
  zle redisplay
}
zle -N television-cd
for keymap in viins vicmd emacs; do
  bindkey -M "$keymap" '^F' television-cd
done
unset keymap
