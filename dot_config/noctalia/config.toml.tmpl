# Noctalia v5 base config, tracked by chezmoi. Merged with rice.toml (generated by
# `rice`: fonts and surface opacity); settings.toml in ~/.local/state/noctalia is
# written by the Settings UI and wins over both, so rice strips only the keys it owns
# from it. See ~/.config/rice/README.md.

[theme]
mode = "dark"
# Pinned to the approved rice palette; the wallpaper generator never overwrites it.
source = "custom"
custom_palette = "Rice"

    [theme.templates]
    # rice renders every app theme itself; Noctalia must not write over them.
    enable_builtin_templates = false
    enable_community_templates = false

[shell]
corner_radius_scale = 1.0
settings_window_translucent = true

    [shell.panel]
    # rice.toml selects glass/soft/solid from measured text contrast.
    transparency_mode = "glass"

[bar.default]
# Floating bar: inset from the screen edge with rounded ends and a soft shadow.
radius = 12
margin_edge = 10
compositor_blur = true
shadow = true

[lockscreen]
# Blur the lock screen's own wallpaper; never show the unlocked session.
blurred_desktop = false
blur_intensity = 0.6
tint_intensity = 0.35

[hooks]
# The stock wallpaper picker goes through rice: approved images apply their palette,
# unknown ones are drafted for review and the previous wallpaper is put back.
wallpaper_changed = ['"$HOME/.local/bin/rice" hook wallpaper-changed']

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/.local/share/wallpapers"

[plugins]
enabled = ["lomzem/rice"]

    [[plugins.source]]
    enabled = true
    kind = "path"
    location = "{{ .chezmoi.homeDir }}/.local/share/rice/noctalia-plugins"
    name = "rice"

    # Defining sources replaces the defaults, so the stock ones are listed again.
    [[plugins.source]]
    enabled = true
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    enabled = true
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"
